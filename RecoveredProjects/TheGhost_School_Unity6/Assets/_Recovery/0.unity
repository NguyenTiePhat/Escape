--- !u!114 &472567883
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 472567882}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2eb32a1557ab15a4bb5e64578ce23019, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StartRoom
  noteTitle: "G\u1EEDi ng\u01B0\u1EDDi t\u1EC9nh d\u1EADy trong c\u0103n ph\xF2ng
    n\xE0y"
  noteText: "N\u1EBFu b\u1EA1n \u0111\u1ECDc \u0111\u01B0\u1EE3c nh\u1EEFng d\xF2ng
    n\xE0y, h\xE3y gi\u1EEF b\xECnh t\u0129nh.\n\nNh\u1EB7t chi\u1EBFc \u0111\xE8n
    pin tr\xEAn b\xE0n tr\u01B0\u1EDBc khi r\u1EDDi ph\xF2ng. Nh\u1EA5n L \u0111\u1EC3
    b\u1EADt ho\u1EB7c t\u1EAFt \u0111\xE8n.\n\nKh\xE1m ph\xE1 c\xE1c ph\xF2ng h\u1ECDc,
    t\xECm v\u1EADt d\u1EE5ng v\xE0 manh m\u1ED1i \u0111\u1EC3 m\u1EDF \u0111\u01B0\u1EDDng
    tho\xE1t kh\u1ECFi tr\u01B0\u1EDDng. H\xE3y quan s\xE1t k\u1EF9 nh\u1EEFng g\xF3c
    t\u1ED1i.\n\nWASD: di chuy\u1EC3n \u2022 Chu\u1ED9t: nh\xECn quanh \u2022 Shift:
    ch\u1EA1y\nE: t\u01B0\u01A1ng t\xE1c v\u1EDBi v\u1EADt \u0111ang nh\xECn\n\n\u0110\u1EEBng
    b\u1ECF qua nh\u1EEFng m\u1EA9u gi\u1EA5y b\u1EA1n t\xECm th\u1EA5y."
  view: {fileID: 348079987}
  flashlightObject: {fileID: 892832307}
  hands: {fileID: 0}
