      - rid: 6820423584242466833
  - m_Id: 154479298993971200
    m_Localized: '{} - Взаємодія'
    m_Metadata:
      m_Items:
      - rid: 6820423584242466833
  - m_Id: 154479373619027968
    m_Localized: '{} - Чат'
    m_Metadata:
      m_Items:
      - rid: 6820423584242466833
  - m_Id: 154479570373828608
    m_Localized: '{} - Спостерігати'
    m_Metadata:
      m_Items:
      - rid: 6820423584242466833
  - m_Id: 154482917361311744
    m_Localized: Нормальний
    m_Metadata:
      m_Items: []
  - m_Id: 154483067920048128
    m_Localized: Легко (без монстрів)
    m_Metadata:
      m_Items: []
  - m_Id: 154483348296687616
    m_Localized: Створити гру (приватну)
    m_Metadata:
      m_Items: []
  - m_Id: 154483442240708608
    m_Localized: Приєднатися
    m_Metadata:
      m_Items: []
  - m_Id: 156222931038711808
    m_Localized: 'Примітка: вимкніть «Постобробку» в налаштуваннях, якщо продуктивність низька'
    m_Metadata:
      m_Items: []
  - m_Id: 156325667126194176
    m_Localized: Продавайте речі на ринку, щоб отримати золотий XP
    m_Metadata:
      m_Items: []
  - m_Id: 157646892152381440
    m_Localized: Дерев'яний ящик 2
    m_Metadata:
      m_Items: []
  - m_Id: 157646929578156032
    m_Localized: Токсичний ящик
    m_Metadata:
      m_Items: []
  - m_Id: 157646996322115584
    m_Localized: Гумовий
    m_Metadata:
      m_Items: []
  - m_Id: 157647027338993664
    m_Localized: Інтерн
    m_Metadata:
