    m_Metadata:
      m_Items: []
  - m_Id: 157647362581323776
    m_Localized: Повсякденний
    m_Metadata:
      m_Items: []
  - m_Id: 157647409968570368
    m_Localized: Офіс
    m_Metadata:
      m_Items: []
  - m_Id: 157647424078209024
    m_Localized: Зникати
    m_Metadata:
      m_Items: []
