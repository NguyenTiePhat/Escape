  m_TableData:
  - m_Id: 283349344256
    m_Localized: Medkit
    m_Metadata:
      m_Items: []
  - m_Id: 315309940736
    m_Localized: Meningkatkan kecepatan revive. Keuntungan ini tidak menggunakan tempat.
    m_Metadata:
      m_Items: []
  - m_Id: 49629382041600
    m_Localized: 'Jenis : Barang'
    m_Metadata:
      m_Items: []
  - m_Id: 5498379483209728
    m_Localized: 'Kecepatan:'
    m_Metadata:
      m_Items: []
  - m_Id: 5498460529745920
    m_Localized: Detik
    m_Metadata:
      m_Items: []
