  - m_Id: 248595421548503040
    m_Localized: 'อินพุตโปรแกรมจำลอง:'
    m_Metadata:
      m_Items: []
  - m_Id: 3042222537695232
    m_Localized: คุณภาพของตัวละคร
    m_Metadata:
      m_Items: []
  - m_Id: 3042575907807232
