    m_Localized: שדרוג
    m_Metadata:
      m_Items: []
  - m_Id: 100705914619682816
    m_Localized: תחילה עליך לבטל את נעילת ההטבה הקודמת
    m_Metadata:
      m_Items: []
  - m_Id: 108671702144114688
    m_Localized: בְּעִיטָה
    m_Metadata:
      m_Items: []
  - m_Id: 110199398779052032
    m_Localized: פרס
    m_Metadata:
      m_Items: []
  - m_Id: 110200392724242432
    m_Localized: עונה הסתיימה
    m_Metadata:
      m_Items: []
  - m_Id: 188422864329760768
    m_Localized: חדרים
    m_Metadata:
      m_Items: []
  - m_Id: 188424197275377664
