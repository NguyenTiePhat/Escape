    m_Localized: מקלדת
    m_Metadata:
      m_Items: []
  - m_Id: 345008120292958208
    m_Localized: גיימפקט
    m_Metadata:
      m_Items: []
  - m_Id: 345781354399522816
    m_Localized: מצב כריעה
    m_Metadata:
