    m_Localized: Найкраще за весь час
    m_Metadata:
      m_Items: []
  - m_Id: 97900132069007360
    m_Localized: Запрошення в лобі
    m_Metadata:
      m_Items: []
  - m_Id: 97903510752845824
    m_Localized: Вихід з лобі
