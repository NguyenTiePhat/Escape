    m_Localized: Mezbahadaki ultraviyole ile el izlerini algıla
    m_Metadata:
      m_Items: []
  - m_Id: 286335479499972608
    m_Localized: Apartmanlarda 4. kata ulaş
    m_Metadata:
      m_Items: []
