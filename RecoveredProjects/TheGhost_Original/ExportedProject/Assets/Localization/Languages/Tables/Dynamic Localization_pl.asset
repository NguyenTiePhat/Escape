    m_Metadata:
      m_Items:
      - rid: 0
  - m_Id: 14091804672
    m_Localized: Możesz schować się pod stołem
    m_Metadata:
      m_Items: []
  - m_Id: 109650632704
    m_Localized: Nie rób żadnego hałasu – duch cię usłyszy
    m_Metadata:
      m_Items: []
  - m_Id: 121793142784
    m_Localized: Zbieraj dokumenty, aby dowiedzieć się, co wydarzyło się w szpitalu New Wishlie
    m_Metadata:
      m_Items: []
  - m_Id: 146858303488
    m_Localized: Możesz zamknąć posąg za drzwiami
    m_Metadata:
      m_Items: []
  - m_Id: 1299573141135360
    m_Localized: Nie możesz się ukryć w trybie „Przetrwania”.
    m_Metadata:
      m_Items: []
  - m_Id: 8674990290362368
    m_Localized: Krucyfiks może uratować Cię przed atakiem ducha
    m_Metadata:
      m_Items: []
  - m_Id: 47462536444895232
    m_Localized: Poruszaj się powoli, gdy Godwilla pojawi się w pobliżu
    m_Metadata:
      m_Items: []
  - m_Id: 78613588736991232
    m_Localized: Napraw skrzynkę bezpieczników, aby włączyć zasilanie
    m_Metadata:
      m_Items: []
  - m_Id: 78613639693590528
    m_Localized: Przez cały czas utrzymuj kontakt wzrokowy z posągiem
    m_Metadata:
      m_Items: []
  - m_Id: 78613651655745536
    m_Localized: Rozwiąż zagadkę z bramą, aby uciec
    m_Metadata:
      m_Items: []
  - m_Id: 78613881897869312
    m_Localized: Crawler widzi Cię przy włączonej latarce
    m_Metadata:
      m_Items: []
  - m_Id: 78613908162600960
    m_Localized: Włącz wszystkie generatory, aby otworzyć główną bramę
    m_Metadata:
      m_Items: []
  - m_Id: 78614076979142656
    m_Localized: Napraw samochód, aby uciec
    m_Metadata:
      m_Items: []
  - m_Id: 78614092598730752
    m_Localized: Części są rozmieszczone losowo na mapie
    m_Metadata:
      m_Items: []
  - m_Id: 78614108767772672
    m_Localized: Niektóre drzwi mogą wymagać klucza
    m_Metadata:
      m_Items: []
