    m_Localized: Korzystaj z handlu, aby wymieniać przedmioty ze znajomymi
    m_Metadata:
      m_Items: []
  - m_Id: 142045609591123968
    m_Localized: Utwórz lobby, aby grać w trybie rywalizacji lub swobodnej gry ze znajomymi
