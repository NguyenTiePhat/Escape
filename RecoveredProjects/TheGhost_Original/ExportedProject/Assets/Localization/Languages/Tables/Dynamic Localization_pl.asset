      m_Items: []
  - m_Id: 142040497997033472
    m_Localized: Użyj epickiej jakości, aby uzyskać realistyczną grafikę
    m_Metadata:
      m_Items: []
  - m_Id: 142041350506098688
    m_Localized: Możesz wybrać tryb niestandardowy w pokojach
    m_Metadata:
      m_Items: []
  - m_Id: 142041780195766272
    m_Localized: Wyższa liga pozwala na odblokowanie nowych perków
    m_Metadata:
      m_Items: []
  - m_Id: 142042091991937024
    m_Localized: 'Tryb rywalizacji: wyższa liga ma trudniejszych wrogów'
    m_Metadata:
      m_Items: []
  - m_Id: 142042467675746304
    m_Localized: Dotrzyj do 100 najlepszych rankingów w tabeli liderów, aby otrzymać ekskluzywne nagrody
    m_Metadata:
      m_Items: []
  - m_Id: 142043501630402560
    m_Localized: Wygląd ubrań zależy od stopnia zużycia, przy większym zużyciu mogą wyglądać na brudniejsze
    m_Metadata:
