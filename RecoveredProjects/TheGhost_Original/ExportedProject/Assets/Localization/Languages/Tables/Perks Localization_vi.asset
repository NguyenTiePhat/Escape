  m_Script: {fileID: -622809992, guid: 76ad3cbe9d98d83f7de53e0a92768023, type: 3}
  m_Name: Perks Localization_vi
  m_EditorClassIdentifier:
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: b08dad84b549bab408e51a0990ebd828, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 283349344256
    m_Localized: Hộp y tế
    m_Metadata:
      m_Items: []
  - m_Id: 315309940736
    m_Localized: Tăng tốc độ hồi sinh đồng đội của bạn. Đặc quyền này không tốn không gian.
    m_Metadata:
      m_Items: []
  - m_Id: 49629382041600
    m_Localized: 'Loại: Vật phẩm'
    m_Metadata:
      m_Items: []
  - m_Id: 5498379483209728
    m_Localized: 'Tốc độ :'
    m_Metadata:
      m_Items: []
  - m_Id: 5498460529745920
    m_Localized: giây
    m_Metadata:
      m_Items: []
  - m_Id: 5515030190612480
    m_Localized: 'Phạm vi:'
    m_Metadata:
      m_Items: []
  - m_Id: 5515049660571648
    m_Localized: Mét
    m_Metadata:
      m_Items: []
  - m_Id: 5515924202315776
    m_Localized: 'Khoảng thời gian:'
    m_Metadata:
      m_Items: []
  - m_Id: 5516726228738048
    m_Localized: 'Cơ hội kích hoạt :'
    m_Metadata:
      m_Items: []
  - m_Id: 5516976561577984
    m_Localized: 'Bán kính:'
    m_Metadata:
      m_Items: []
  - m_Id: 22112023566344192
    m_Localized: 'Loại: Tùy tình huống'
    m_Metadata:
      m_Items: []
  - m_Id: 22112095221833728
    m_Localized: 'Loại: Không ổn định'
    m_Metadata:
      m_Items: []
  - m_Id: 22112159025586176
    m_Localized: 'Loại: Ban phước'
    m_Metadata:
      m_Items: []
  - m_Id: 22117739005992960
    m_Localized: '% trên mỗi cái chết'
    m_Metadata:
      m_Items: []
  - m_Id: 22122496789569536
    m_Localized: 'Phạm vi truy đuổi:'
    m_Metadata:
      m_Items: []
  - m_Id: 22142452302340096
    m_Localized: Mét trên mỗi lần chết
    m_Metadata:
      m_Items: []
  - m_Id: 22154363693686784
    m_Localized: Muối
    m_Metadata:
      m_Items: []
  - m_Id: 22154378675740672
    m_Localized: Ngăn không cho ma xâm nhập vào vùng đặt muối. Vài ma có thể vô hiệu hóa đặc quyền này.
    m_Metadata:
      m_Items: []
  - m_Id: 22154425832300544
    m_Localized: Cây thánh giá
    m_Metadata:
      m_Items: []
  - m_Id: 22154457302163456
    m_Localized: Ngăn chặn sự tấn công của ma
    m_Metadata:
      m_Items: []
  - m_Id: 22154494929264640
    m_Localized: Lựu đạn choáng
    m_Metadata:
      m_Items: []
  - m_Id: 22154532678000640
    m_Localized: Khi được sử dụng, kẻ thù sẽ bị mù và không thể di chuyển.
    m_Metadata:
      m_Items: []
  - m_Id: 22154566865772544
    m_Localized: Không mất điện
    m_Metadata:
      m_Items: []
  - m_Id: 22154624453566464
    m_Localized: Có khả năng bạn sẽ không còn bị ảnh hưởng bởi mất điện ở Trường. Đặc quyền này không tốn không gian.
    m_Metadata:
      m_Items: []
  - m_Id: 22154681273802752
    m_Localized: Thuốc
    m_Metadata:
      m_Items: []
  - m_Id: 22154724861009920
    m_Localized: Thuốc tăng phạm vi khả năng khám phá của bạn lên xa hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 22154745622814720
    m_Localized: Cứu sinh
    m_Metadata:
      m_Items: []
  - m_Id: 22154805643304960
    m_Localized: Sau khi hồi sinh một đồng đội, bạn phát hiện ra các vật phẩm trong phạm vi xa hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 22154836043620352
    m_Localized: Khởi đầu tốt
    m_Metadata:
      m_Items: []
  - m_Id: 22154889156091904
    m_Localized: Trước khi đồng đội đầu tiên của bạn chết, bạn sẽ trở nên kín đáo và thận trọng hơn. Bán kính truy đuổi của kẻ thù giảm và bạn nhìn thấy hào quang của kẻ thù. Tự động kích hoạt khi trận đấu bắt đầu
    m_Metadata:
      m_Items: []
  - m_Id: 22154913957011456
    m_Localized: Người chăm sóc
    m_Metadata:
      m_Items: []
  - m_Id: 22154949566652416
    m_Localized: Bán kính truy đuổi của kẻ thù được giảm đối với đồng đội được hồi sinh.
    m_Metadata:
      m_Items: []
  - m_Id: 22154971372838912
    m_Localized: Thận trọng
    m_Metadata:
      m_Items: []
  - m_Id: 22155067451760640
    m_Localized: Sự thận trọng của bạn cho phép bạn nhìn thấy hào quang của kẻ thù mỗi lần bạn nhặt đồ vật lần đầu tiên.
    m_Metadata:
      m_Items: []
  - m_Id: 22155093037015040
    m_Localized: Trực giác
    m_Metadata:
      m_Items: []
  - m_Id: 22156070620225536
    m_Localized: 'Sau khi tắt đèn pin, bạn sẽ thấy hào quang của kẻ bò tường. Thời gian hồi chiêu: 30 giây.'
    m_Metadata:
      m_Items: []
  - m_Id: 22156102782148608
    m_Localized: Người lãnh đạo
    m_Metadata:
      m_Items: []
  - m_Id: 22156129495670784
    m_Localized: Bạn nhìn thấy các vật phẩm trong phạm vi lớn hơn khi ở gần đồng đội của mình.
    m_Metadata:
      m_Items: []
  - m_Id: 22156149309562880
    m_Localized: Sổ ghi chú
    m_Metadata:
      m_Items: []
  - m_Id: 22156197300789248
    m_Localized: Những vật phẩm quan trọng mà bạn đã đi qua được đánh dấu trên bản đồ của bạn
    m_Metadata:
      m_Items: []
  - m_Id: 22156225696227328
    m_Localized: Vì mọi người
    m_Metadata:
      m_Items: []
  - m_Id: 22156297368494080
    m_Localized: 'Khi kích hoạt, bán kính truy đuổi của kẻ địch tăng 100% cho bạn, giảm <color=#17fc03>x%</color> cho người khác. Thời gian hiệu ứng: 1 phút.'
    m_Metadata:
      m_Items: []
  - m_Id: 22156430613143552
    m_Localized: Hộ vệ linh hồn
    m_Metadata:
      m_Items: []
  - m_Id: 22156488372903936
    m_Localized: Sau khi được hồi sinh, bạn nhìn thấy hào quang của kẻ thù.
    m_Metadata:
      m_Items: []
  - m_Id: 22156964065697792
    m_Localized: Tỉnh dậy đi!
    m_Metadata:
      m_Items: []
  - m_Id: 22157011054485504
    m_Localized: Khi một đồng đội của bạn rơi vào tình trạng hấp hối, bạn nhìn thấy các vật phẩm trong phạm vi xa hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 22157035318534144
    m_Localized: Báo thù cái chết
    m_Metadata:
      m_Items: []
  - m_Id: 22157080449245184
    m_Localized: Bạn bắt đầu nhìn thấy hào quang của kẻ thù sau khi một trong những đồng đội của bạn bị giết.
    m_Metadata:
      m_Items: []
  - m_Id: 22157109339611136
    m_Localized: Bỏ lại phía sau
    m_Metadata:
      m_Items: []
  - m_Id: 22157160245878784
    m_Localized: Khi cách đồng đội của bạn hơn 7 mét, có khả năng kẻ thù sẽ không đuổi theo bạn.
    m_Metadata:
      m_Items: []
  - m_Id: 22157187403997184
    m_Localized: Báo thù cho đội
    m_Metadata:
      m_Items: []
  - m_Id: 22157233201602560
    m_Localized: Khi bạn bị bỏ lại một mình, bạn trở nên kín đáo hơn. Bán kính truy đuổi của kẻ thù giảm và bạn nhìn thấy hào quang của kẻ thù.
    m_Metadata:
      m_Items: []
  - m_Id: 22157273185902592
    m_Localized: Sốc
    m_Metadata:
      m_Items: []
  - m_Id: 22157309797982208
    m_Localized: Sau khi tìm thấy một xác chết, bạn có thêm phạm vi nhìn thấy hào quang của kẻ thù.
    m_Metadata:
      m_Items: []
  - m_Id: 22157337778184192
    m_Localized: Gotcha
    m_Metadata:
      m_Items: []
  - m_Id: 22157371856904192
    m_Localized: Lấy vật phẩm đã được tìm thấy cho phép bạn nhìn thấy các vật phẩm trong phạm vi lớn hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 22157398012583936
    m_Localized: Kẻ sống sót duy nhất
    m_Metadata:
      m_Items: []
  - m_Id: 22157456598622208
    m_Localized: Mỗi khi một đồng đội của bạn chết, bán kính truy đuổi của kẻ địch giảm <color=#17fc03>x%</color>
    m_Metadata:
      m_Items: []
  - m_Id: 22157482217431040
    m_Localized: Giác quan thứ sáu
    m_Metadata:
      m_Items: []
  - m_Id: 22157534663008256
    m_Localized: Khi bạn hoàn thành nhiệm vụ, bạn sẽ nhìn thấy hào quang của kẻ thù
    m_Metadata:
      m_Items: []
  - m_Id: 22157564610338816
    m_Localized: Chúng ta sẽ làm được
    m_Metadata:
      m_Items: []
  - m_Id: 22157612257632256
    m_Localized: Sau khi một trong những đồng đội được hồi sinh, bạn tràn đầy nhiệt huyết và nhìn thấy các vật phẩm trong phạm vi lớn hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 22157649419165696
    m_Localized: Đồng cảm
    m_Metadata:
      m_Items: []
  - m_Id: 22157694633762816
    m_Localized: Bạn nhìn thấy hào quang của đồng đội đang trong tình trạng nằm chết.
    m_Metadata:
      m_Items: []
  - m_Id: 22157726493696000
    m_Localized: Liên kết
    m_Metadata:
      m_Items: []
  - m_Id: 22157778867970048
    m_Localized: Tốt hơn hết các bạn nên ở bên nhau. Khi ở gần đồng đội trong phạm vi 10 mét, bạn sẽ thấy hào quang của kẻ thù.
    m_Metadata:
      m_Items: []
  - m_Id: 22157801001312256
    m_Localized: Chứng điên cuồng
    m_Metadata:
      m_Items: []
  - m_Id: 22157841627340800
    m_Localized: Bạn ngẫu nhiên nhìn thấy hào quang của kẻ thù <color=#17fc03>x</color> giây (cứ sau 1-3 phút)
    m_Metadata:
      m_Items: []
  - m_Id: 22157870513512448
    m_Localized: Hy vọng
    m_Metadata:
      m_Items: []
  - m_Id: 22157901601693696
    m_Localized: Bạn có một hy vọng mạnh mẽ. Bạn ngẫu nhiên nhìn thấy các vật phẩm trong phạm vi lớn hơn trong thời gian <color=#17fc03>x</color> giây (cứ sau 1-3 phút).
    m_Metadata:
      m_Items: []
  - m_Id: 22157926121594880
    m_Localized: Méo mó
    m_Metadata:
      m_Items: []
  - m_Id: 22157971759816704
    m_Localized: Kẻ thù không cảm thấy bạn ở sau bức tường và sẽ không đuổi theo nếu bạn đang ở trong bán kính truy đuổi của hắn
    m_Metadata:
      m_Items: []
  - m_Id: 22157999828099072
    m_Localized: Mắt đại bàng
    m_Metadata:
      m_Items: []
  - m_Id: 22158040366047232
    m_Localized: Bạn nhìn thấy một vật phẩm từ khoảng cách rất xa
    m_Metadata:
      m_Items: []
  - m_Id: 279797773596876800
    m_Localized: Tốc độ gỡ bẫy được tăng lên. Đặc quyền này không tốn không gian.
    m_Metadata:
      m_Items: []
  - m_Id: 279797793138139136
    m_Localized: Bạn có cơ hội tránh được bẫy gấu, thời gian hồi chiêu 10 giây. Đặc quyền này không tốn không gian.
    m_Metadata:
      m_Items: []
  - m_Id: 279797822892531712
    m_Localized: Trong khi bị truy đuổi, tất cả người chơi nhận được khả năng nhìn thấy vật phẩm trong phạm vi lớn hơn.
    m_Metadata:
      m_Items: []
  - m_Id: 380154348361998336
    m_Localized: Quá tải
    m_Metadata:
      m_Items: []
  - m_Id: 380154398534262784
    m_Localized: Thuốc tàng hình
    m_Metadata:
      m_Items: []
  - m_Id: 380154449704771584
    m_Localized: Mốc đen
    m_Metadata:
      m_Items: []
  - m_Id: 380154475566850048
    m_Localized: Hố đen
    m_Metadata:
      m_Items: []
  - m_Id: 380154507762327552
    m_Localized: Thiết bị trinh sát
    m_Metadata:
      m_Items: []
  - m_Id: 380154538946977792
    m_Localized: Dây bẫy đóng băng
    m_Metadata:
      m_Items: []
  - m_Id: 380154575684886528
    m_Localized: Tỏi
    m_Metadata:
      m_Items: []
  - m_Id: 380154630596714496
    m_Localized: Máy dịch chuyển vật phẩm
    m_Metadata:
      m_Items: []
  - m_Id: 380154664746737664
    m_Localized: Máy dịch chuyển ma
    m_Metadata:
      m_Items: []
  - m_Id: 380154706001911808
    m_Localized: Camera an ninh
    m_Metadata:
      m_Items: []
  - m_Id: 380154845932281856
    m_Localized: Truy đuổi bất ngờ
    m_Metadata:
      m_Items: []
  - m_Id: 380154891562115072
    m_Localized: Ân sủng hộ mệnh
    m_Metadata:
      m_Items: []
  - m_Id: 380154929809973248
    m_Localized: Trạng thái đảo ngược
    m_Metadata:
      m_Items: []
  - m_Id: 380154961065926656
    m_Localized: Nhị hồn
    m_Metadata:
      m_Items: []
  - m_Id: 380155012517453824
    m_Localized: Hồi sinh thanh tao
    m_Metadata:
      m_Items: []
  - m_Id: 380155084219080704
    m_Localized: Ký ức bị lãng quên
    m_Metadata:
      m_Items: []
  - m_Id: 380155147183972352
    m_Localized: Lồng phong ấn ma
    m_Metadata:
      m_Items: []
  - m_Id: 380155197448511488
    m_Localized: Gương vật phẩm
    m_Metadata:
      m_Items: []
  - m_Id: 380155236128382976
    m_Localized: Sóng lực
    m_Metadata:
      m_Items: []
  - m_Id: 380155278671208448
    m_Localized: tường ma
    m_Metadata:
      m_Items: []
  - m_Id: 380155310187208704
    m_Localized: Thần giao cách cảm
    m_Metadata:
      m_Items: []
  - m_Id: 380155339882881024
    m_Localized: Phục sinh
    m_Metadata:
      m_Items: []
  - m_Id: 380155393309925376
    m_Localized: Thao túng tâm trí
    m_Metadata:
      m_Items: []
  - m_Id: 387154197999857664
    m_Localized: Đèn pin của bạn không tắt ở trường
    m_Metadata:
      m_Items: []
  - m_Id: 387154237149491200
    m_Localized: Khi sử dụng bạn trở nên vô hình đối với kẻ thù
    m_Metadata:
      m_Items: []
  - m_Id: 387154323124334592
    m_Localized: Mốc đen làm chậm kẻ thù khi chúng bước vào. Vài ma có thể vô hiệu hóa đặc quyền này.
    m_Metadata:
      m_Items: []
  - m_Id: 387154858715983872
    m_Localized: Những vật phẩm mà đồng đội của bạn đi ngang qua sẽ được hiện lên cho bạn.
    m_Metadata:
      m_Items: []
  - m_Id: 387154891754516480
    m_Localized: Hồi sinh tất cả đồng đội khi sử dụng.
    m_Metadata:
      m_Items: []
  - m_Id: 387154363553230848
    m_Localized: Kéo kẻ thù vào hố đen.
    m_Metadata:
      m_Items: []
  - m_Id: 387154572261797888
    m_Localized: Khi bước vào một cuộc truy đuổi và kẻ thù đến gần, tốc độ di chuyển của bạn sẽ được tăng lên và bạn nhìn thấy hào quang của kẻ thù.
    m_Metadata:
      m_Items: []
  - m_Id: 387154685390565376
    m_Localized: Sau khi được hồi sinh, bạn sẽ được miễn nhiễm với ma trong <color=#17fc03>x</color> giây.
    m_Metadata:
      m_Items: []
  - m_Id: 387154803598635008
    m_Localized: Bạn có những làn sóng rung động đẩy kẻ thù ra xa. Khoảng thời gian không giới hạn.
    m_Metadata:
      m_Items: []
  - m_Id: 387154831050354688
    m_Localized: Tạo ra bức tường mà anh ma không thể vượt qua. Vài ma có thể vô hiệu hóa đặc quyền này.
    m_Metadata:
      m_Items: []
  - m_Id: 410255897056849920
    m_Localized: Bẫy Giáng Sinh
    m_Metadata:
      m_Items: []
  - m_Id: 410255922163953664
    m_Localized: Dụ kẻ thù vào bẫy.
    m_Metadata:
      m_Items: []
  - m_Id: 410256233104486400
    m_Localized: Đầu đọc EMF
    m_Metadata:
      m_Items: []
  - m_Id: 410256257041379328
    m_Localized: Định vị sự hiện diện của kẻ thù khi hướng vào trong phạm vi 50 mét.
    m_Metadata:
      m_Items: []
  - m_Id: 410710839915786240
    m_Localized: Hoàn Phục Sư
    m_Metadata:
      m_Items: []
  - m_Id: 410710870286741504
    m_Localized: Hồi phục cho mọi người chơi trong phạm vi 5 mét trong <color=green>x</color> giây.
    m_Metadata:
      m_Items: []
  - m_Id: 387154542528376832
    m_Localized: Camera được lắp đặt xung quanh bản đồ và sẽ phát hiện nhất cử nhất động của kẻ thù và thông báo cho bạn. Sử dụng thiết bị để xem camera.
    m_Metadata:
      m_Items: []
  - m_Id: 421602761337286656
    m_Localized: Trí lực nắm bắt
    m_Metadata:
      m_Items: []
  - m_Id: 421602761387618304
    m_Localized: Tự động nhặt đồ xung quanh bạn với phạm vi được tăng lên.
    m_Metadata:
      m_Items: []
  - m_Id: 466014805194432512
    m_Localized: Sách Thánh
    m_Metadata:
      m_Items: []
  - m_Id: 466014829231988736
    m_Localized: 'Ngăn chặn cái chết một lần. Phạm vi: 10 mét'
    m_Metadata:
      m_Items: []
  - m_Id: 387154658832232448
    m_Localized: Bạn di chuyển nhanh hơn gấp 10 lần khi là "linh hồn" và có thể tìm thấy vật phẩm. Hiệu ứng này có hiệu lực trong một khoảng thời gian nhất định hoặc cho đến khi bạn bị ma tấn công.
    m_Metadata:
      m_Items: []
  - m_Id: 480197601389342720
    m_Localized: Điềm báo
    m_Metadata:
      m_Items: []
  - m_Id: 480197620532146176
    m_Localized: Bạn nhìn thấy một người chơi có khả năng sẽ chết trong 5 phút tới.
    m_Metadata:
      m_Items: []
  - m_Id: 480197673795612672
    m_Localized: Giày tăng tốc
    m_Metadata:
      m_Items: []
  - m_Id: 480197696054784000
    m_Localized: Tốc độ của bạn được tăng thêm vĩnh viễn. Đặc quyền này không tốn không gian.
    m_Metadata:
      m_Items: []
  - m_Id: 480197835196624896
    m_Localized: Phác thảo
    m_Metadata:
      m_Items: []
  - m_Id: 480197853701894144
    m_Localized: Các vật phẩm quan trọng có thể nhìn thấy sau các bức tường. Đặc quyền này không tốn không gian.
    m_Metadata:
      m_Items: []
  - m_Id: 480197895993061376
    m_Localized: Trỗi dậy từ tro tàn
    m_Metadata:
      m_Items: []
  - m_Id: 480197912346652672
    m_Localized: Bạn sẽ được hồi sinh ngay lập tức khi bạn đang trong trạng thái nằm chết và một trong những đồng đội của bạn rơi vào trạng thái nằm chết.
    m_Metadata:
      m_Items: []
  - m_Id: 480197956508479488
    m_Localized: Người vận chuyển
    m_Metadata:
      m_Items: []
  - m_Id: 480197974531403776
    m_Localized: Khi mang theo vật phẩm, bạn sẽ thấy hào quang của kẻ địch trong phạm vi nhất định.
    m_Metadata:
      m_Items: []
  - m_Id: 480198018387046400
    m_Localized: Bẫy tử thần
    m_Metadata:
      m_Items: []
  - m_Id: 480198032249221120
    m_Localized: Khi bạn đang trong trạng thái nằm chết, tốc độ của kẻ địch sẽ giảm.
    m_Metadata:
      m_Items: []
  - m_Id: 480198071621152768
    m_Localized: Tự chữa thương
    m_Metadata:
      m_Items: []
  - m_Id: 480198084845793280
    m_Localized: Bạn sẽ được hồi sinh khi chết lần đầu. Bạn cũng có cơ hội đứng dậy khi chết lần tiếp theo.
    m_Metadata:
      m_Items: []
  - m_Id: 480198179842584576
    m_Localized: Bác Sĩ
    m_Metadata:
      m_Items: []
  - m_Id: 480198191662133248
    m_Localized: Chuyên môn y tế của bạn cho phép bạn hồi máu cho những người khác mà không cần túi y tế.
    m_Metadata:
      m_Items: []
  - m_Id: 387154714687778816
    m_Localized: Ma sẽ kết thúc cuộc truy đuổi khi nó mất dấu bạn sau một khoảng thời gian nhất định.
    m_Metadata:
      m_Items: []
  - m_Id: 480894447495667712
    m_Localized: Bạn có một phước lành tái sinh - sau khi được hồi sinh, tốc độ di chuyển của bạn tăng lên <color=green>%</color>, tốc độ của kẻ địch giảm đi <color=yellow>%</color>. Đặc quyền này có hiệu lực trong X giây.
    m_Metadata:
      m_Items: []
  - m_Id: 387154919256567808
    m_Localized: Bạn điều khiển kẻ thù trong vài giây tiếp theo.
    m_Metadata:
      m_Items: []
  - m_Id: 387154424571965440
    m_Localized: Khi Anh Ma Đạp Vào Dây Bẫy Sẽ Bị Đóng Băng Theo Thời Gian
    m_Metadata:
      m_Items: []
  - m_Id: 387154744228261888
    m_Localized: Ma sẽ bị mắc kẹt trong lồng khi cuộc tấn công bắt đầu.
    m_Metadata:
      m_Items: []
  - m_Id: 480894370425331712
    m_Localized: Phước Lành Tái Sinh
    m_Metadata:
      m_Items: []
  - m_Id: 514693282663755776
    m_Localized: Búp bê bị nguyền rủa
    m_Metadata:
      m_Items: []
  - m_Id: 515683144200089600
    m_Localized: Búp bê bị nguyền rủa di chuyển rất nhanh và thu hút kẻ thù.
    m_Metadata:
      m_Items: []
  - m_Id: 534924261118439424
    m_Localized: Con đường ma
    m_Metadata:
      m_Items: []
  - m_Id: 534931523098636288
    m_Localized: Lá bài đa năng
    m_Metadata:
      m_Items: []
  - m_Id: 538161340308779008
    m_Localized: Hiển thị chuyển động dự đoán của kẻ địch dưới dạng những dấu chân phát sáng trên mặt đất.
    m_Metadata:
      m_Items: []
  - m_Id: 538161409179250688
    m_Localized: Thay thế một đặc quyền ngẫu nhiên vào đầu trận. Sau khi chết, đặc quyền của tất cả người sống sót có thể được sử dụng lại.
    m_Metadata:
      m_Items: []
  - m_Id: 621616059259338752
    m_Localized: Mũi tiêm Adrenaline
    m_Metadata:
      m_Items: []
  - m_Id: 621616091551285248
    m_Localized: Sau khi sử dụng, tốc độ của bạn sẽ tăng mạnh trong một khoảng thời gian nhất định.
    m_Metadata:
      m_Items: []
  - m_Id: 644086898430832640
    m_Localized: Xà beng
    m_Metadata:
      m_Items: []
  - m_Id: 644086930890551296
    m_Localized: Cho phép bạn cạy mở các cánh cửa bị khóa
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
