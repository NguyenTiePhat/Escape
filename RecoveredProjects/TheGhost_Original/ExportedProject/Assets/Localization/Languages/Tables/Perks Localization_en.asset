    m_Localized: Guardian Grace
    m_Metadata:
      m_Items: []
  - m_Id: 380154929809973248
    m_Localized: Reverse State
    m_Metadata:
      m_Items: []
  - m_Id: 380154961065926656
    m_Localized: Second Soul
    m_Metadata:
      m_Items: []
  - m_Id: 380155012517453824
    m_Localized: Ethereal Resurgence
    m_Metadata:
      m_Items: []
  - m_Id: 380155084219080704
    m_Localized: Forgotten Memory
    m_Metadata:
